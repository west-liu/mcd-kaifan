# 麦当劳 MCP Token —— 必填
# 在 https://open.mcd.cn/mcp 手机号登录，控制台激活领取
MCD_TOKEN=

# 默认城市 / 门店（可选）
DEFAULT_CITY=广州
DEFAULT_STORE=
DEFAULT_STORE_NAME=

# 服务端口
PORT=5173

# 设为 0 关闭真实下单（公网部署建议关闭）
ENABLE_ORDER=1

# 演示口令：设了之后，下单与查订单必须带 x-demo-pass 头才放行
# 公网开放下单前强烈建议填一个别人猜不到的值；留空则完全不校验
DEMO_PASS=

# 跨域白名单：前端不跟后端同域时填前端域名，比如 https://west-liu.github.io
# 默认 * 表示谁都能调，联调方便但更松；正式部署建议收紧
ALLOW_ORIGIN=*

# 可选：配置后启用 AI 一句话点评
TOKLENS_KEY=
TOKLENS_URL=https://hkg.toklens.ai/v1/chat/completions
TOKLENS_MODEL=grok-4.5
